# Altostrat Enterprise HR Agentic Solution (MVP 1) — Environment Configuration
# Copy this file to .env and populate with your environment values.

# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash

# WorkWeek HCM & ServiceImmediately ITSM MCP Endpoints
MOCK_SAAS_BASE_URL=https://mock-saas.aishprabhat.demo.altostrat.com
WORKWEEK_MCP_URL=https://mock-saas.aishprabhat.demo.altostrat.com/work-week/mcp/
WORKWEEK_MCP_TOKEN=your-workweek-mcp-token
SERVICEIMMEDIATELY_MCP_URL=https://mock-saas.aishprabhat.demo.altostrat.com/service-immediately/mcp/
SERVICEIMMEDIATELY_MCP_TOKEN=your-serviceimmediately-mcp-token

# Knowledge Retrieval & Safety Guardrails (Optional Cloud Overrides)
RETRIEVAL_MODE=hybrid
ENABLE_VERTEX_SEARCH=false
VERTEX_AI_SEARCH_LOCATION=global
VERTEX_AI_DATA_STORE_ID=hr-policies-datastore
MODEL_ARMOR_TEMPLATE_ID=

# Serving & Telemetry
ALLOW_ORIGINS=http://localhost:8000
OTEL_TO_CLOUD=false
